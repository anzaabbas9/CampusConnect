# =========================================================
# CampusConnect environment settings - TEMPLATE ONLY
# =========================================================
# How to use:
#   1. Copy this file and name the copy ".env"
#   2. Replace the placeholder values in .env with your real values
#   3. NEVER commit .env (it is listed in .gitignore)
# This file contains placeholders only - no real credentials.

# ---------- Flask ----------
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-string

# ---------- PostgreSQL ----------
# Format: postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+psycopg://your_db_user:your_db_password@localhost:5432/campusconnect

# ---------- Firebase Admin SDK ----------
# Path to your Firebase service account JSON key file.
# Keep this file OUTSIDE the project folder (or in a git-ignored folder).
FIREBASE_CREDENTIALS_PATH=path/to/your-firebase-service-account.json
